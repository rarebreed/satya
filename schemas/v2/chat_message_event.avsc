{
  "type": "record",
  "name": "ChatMessageEvent",
  "namespace": "com.satya.events",
  "doc": "Evolved v2 schema for ChatMessageEvent adding optional ML sentiment_score and detected_intent fields with defaults.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "timezone_offset_min", "type": "int" }
        ]
      }
    },
    { "name": "message_id", "type": "string" },
    {
      "name": "sender",
      "type": {
        "type": "record",
        "name": "Participant",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "user_id", "type": "string" },
          { "name": "username", "type": "string" },
          { "name": "display_name", "type": "string" },
          {
            "name": "participant_kind",
            "type": {
              "type": "enum",
              "name": "ParticipantKind",
              "namespace": "com.satya.types",
              "symbols": ["HUMAN", "AI_AGENT"]
            }
          },
          {
            "name": "role",
            "type": {
              "type": "enum",
              "name": "SessionRole",
              "namespace": "com.satya.types",
              "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
            }
          },
          { "name": "character_id", "type": ["null", "string"], "default": null },
          {
            "name": "ai_agent_info",
            "type": [
              "null",
              {
                "type": "record",
                "name": "AiAgentInfo",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "model_id", "type": "string" },
                  { "name": "persona_id", "type": "string" },
                  { "name": "temperature", "type": "float" }
                ]
              }
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "visibility",
      "type": {
        "type": "enum",
        "name": "MessageVisibility",
        "symbols": ["PUBLIC", "PRIVATE", "GM_ONLY", "HOST_ONLY"]
      }
    },
    {
      "name": "recipients",
      "type": { "type": "array", "items": "com.satya.types.Participant" }
    },
    {
      "name": "channel_context",
      "type": {
        "type": "enum",
        "name": "ChannelContext",
        "symbols": [
          "IN_CHARACTER",
          "OUT_OF_CHARACTER",
          "GM_NARRATION",
          "MEETING_PUBLIC",
          "MEETING_BACKCHANNEL",
          "SYSTEM_NOTICE"
        ]
      }
    },
    { "name": "reply_to_message_id", "type": ["null", "string"], "default": null },
    { "name": "body", "type": "string" },
    { "name": "char_count", "type": "int" },
    { "name": "word_count", "type": "int" },
    { "name": "composition_time_ms", "type": "long" },
    { "name": "is_edited", "type": "boolean" },
    { "name": "sentiment_score", "type": ["null", "float"], "default": null },
    { "name": "detected_intent", "type": ["null", "string"], "default": null }
  ]
}
