{
  "type": "record",
  "name": "SessionLogEvent",
  "namespace": "com.satya.events",
  "doc": "Embedding-friendly plain-text log line prefixed with [session=...] [trace=... span=...<-...] [lineage=...<-...], plus lightweight index columns for PyLance filtering.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          {
            "name": "timezone_offset_min",
            "type": "int",
            "satya.pii_category": "QUASI_IDENTIFIER",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "SET_ZERO"
          }
        ]
      }
    },
    { "name": "log_id", "type": "string" },
    {
      "name": "level",
      "type": {
        "type": "enum",
        "name": "LogLevel",
        "symbols": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
      }
    },
    { "name": "service_name", "type": "string" },
    {
      "name": "actor",
      "satya.subject_role": "PRIMARY_ACTOR",
      "type": [
        "null",
        {
          "type": "record",
          "name": "Participant",
          "namespace": "com.satya.types",
          "fields": [
            {
              "name": "user_id",
              "type": "string",
              "satya.gdpr_subject_key": true,
              "satya.pii_category": "DIRECT_IDENTIFIER",
              "satya.erasure_action": "HMAC_TOMBSTONE",
              "satya.dsar_third_party_mask": true,
              "satya.dsar_mask_value": "redacted-peer"
            },
            {
              "name": "username",
              "type": "string",
              "satya.pii_category": "DIRECT_IDENTIFIER",
              "satya.erasure_action": "REPLACE_STATIC",
              "satya.erasure_replacement": "deleted_user",
              "satya.dsar_third_party_mask": true,
              "satya.dsar_mask_value": "redacted_user"
            },
            {
              "name": "display_name",
              "type": "string",
              "satya.pii_category": "DIRECT_IDENTIFIER",
              "satya.erasure_action": "REPLACE_STATIC",
              "satya.erasure_replacement": "Deleted Participant",
              "satya.dsar_third_party_mask": false
            },
            {
              "name": "participant_kind",
              "type": {
                "type": "enum",
                "name": "ParticipantKind",
                "namespace": "com.satya.types",
                "symbols": ["HUMAN", "AI_AGENT"]
              }
            },
            {
              "name": "role",
              "type": {
                "type": "enum",
                "name": "SessionRole",
                "namespace": "com.satya.types",
                "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
              }
            },
            {
              "name": "character_id",
              "type": ["null", "string"],
              "default": null,
              "satya.pii_category": "PSEUDONYMOUS_ID",
              "satya.erasure_action": "SET_NULL",
              "satya.dsar_third_party_mask": false
            },
            {
              "name": "ai_agent_info",
              "type": [
                "null",
                {
                  "type": "record",
                  "name": "AiAgentInfo",
                  "namespace": "com.satya.types",
                  "fields": [
                    { "name": "model_id", "type": "string" },
                    { "name": "persona_id", "type": "string" },
                    { "name": "temperature", "type": "float" }
                  ]
                }
              ],
              "default": null
            }
          ]
        }
      ],
      "default": null
    },
    { "name": "trace_id", "type": ["null", "string"], "default": null },
    { "name": "span_id", "type": ["null", "string"], "default": null },
    { "name": "parent_span_id", "type": ["null", "string"], "default": null },
    { "name": "lineage_id", "type": ["null", "string"], "default": null },
    {
      "name": "parent_lineage_ids",
      "type": { "type": "array", "items": "string" },
      "default": []
    },
    {
      "name": "log_line",
      "type": "string",
      "satya.pii_category": "DIAGNOSTIC_TEXT",
      "satya.pii_owner": "PRIMARY_ACTOR",
      "satya.erasure_action": "REGEX_SCRUB_SUBJECT"
    }
  ]
}
