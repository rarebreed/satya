{
  "type": "record",
  "name": "WebRtcTelemetryEvent",
  "namespace": "com.satya.events",
  "doc": "Tracks WebRTC signaling, ICE negotiation, track mute states, and QoE network metrics.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          {
            "name": "timezone_offset_min",
            "type": "int",
            "satya.pii_category": "QUASI_IDENTIFIER",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "SET_ZERO"
          }
        ]
      }
    },
    {
      "name": "local_participant",
      "satya.subject_role": "PRIMARY_ACTOR",
      "type": {
        "type": "record",
        "name": "Participant",
        "namespace": "com.satya.types",
        "fields": [
          {
            "name": "user_id",
            "type": "string",
            "satya.gdpr_subject_key": true,
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "HMAC_TOMBSTONE",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted-peer"
          },
          {
            "name": "username",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "deleted_user",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted_user"
          },
          {
            "name": "display_name",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "Deleted Participant",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "participant_kind",
            "type": {
              "type": "enum",
              "name": "ParticipantKind",
              "namespace": "com.satya.types",
              "symbols": ["HUMAN", "AI_AGENT"]
            }
          },
          {
            "name": "role",
            "type": {
              "type": "enum",
              "name": "SessionRole",
              "namespace": "com.satya.types",
              "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
            }
          },
          {
            "name": "character_id",
            "type": ["null", "string"],
            "default": null,
            "satya.pii_category": "PSEUDONYMOUS_ID",
            "satya.erasure_action": "SET_NULL",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "ai_agent_info",
            "type": [
              "null",
              {
                "type": "record",
                "name": "AiAgentInfo",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "model_id", "type": "string" },
                  { "name": "persona_id", "type": "string" },
                  { "name": "temperature", "type": "float" }
                ]
              }
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "remote_participant",
      "satya.subject_role": "SECONDARY_PARTICIPANT",
      "type": ["null", "com.satya.types.Participant"],
      "default": null
    },
    {
      "name": "event_kind",
      "type": {
        "type": "enum",
        "name": "WebRtcEventKind",
        "symbols": [
          "SIGNALING_OFFER",
          "SIGNALING_ANSWER",
          "ICE_CANDIDATE",
          "ICE_STATE_CHANGE",
          "DATA_CHANNEL_OPEN",
          "DATA_CHANNEL_CLOSED",
          "PEER_DISCONNECTED",
          "STATS_SNAPSHOT",
          "TRACK_MUTE_CHANGE"
        ]
      }
    },
    {
      "name": "ice_candidate_type",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "IceCandidateType",
          "symbols": ["HOST", "SRFLX", "PRFLX", "RELAY", "UNKNOWN"]
        }
      ],
      "default": null
    },
    { "name": "rtt_ms", "type": ["null", "float"], "default": null },
    { "name": "jitter_ms", "type": ["null", "float"], "default": null },
    { "name": "packet_loss_rate", "type": ["null", "float"], "default": null },
    { "name": "available_outgoing_bitrate_bps", "type": ["null", "long"], "default": null },
    { "name": "audio_muted", "type": "boolean" },
    { "name": "video_muted", "type": "boolean" }
  ]
}
