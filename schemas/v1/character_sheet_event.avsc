{
  "type": "record",
  "name": "CharacterSheetEvent",
  "namespace": "com.satya.events",
  "doc": "Captures character creation, updates, exports (.satyachar), imports, session binds, multimodal asset uploads (images/PDFs/3D models), and anti-cheat verification audits.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          {
            "name": "timezone_offset_min",
            "type": "int",
            "satya.pii_category": "QUASI_IDENTIFIER",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "SET_ZERO"
          }
        ]
      }
    },
    {
      "name": "character_event_type",
      "type": {
        "type": "enum",
        "name": "CharacterEventType",
        "symbols": [
          "CHARACTER_CREATED",
          "CHARACTER_UPDATED",
          "CHARACTER_EXPORTED",
          "CHARACTER_IMPORTED",
          "CHARACTER_BOUND_TO_SESSION",
          "CHARACTER_ASSET_UPLOADED"
        ]
      }
    },
    {
      "name": "actor",
      "satya.subject_role": "PRIMARY_ACTOR",
      "type": {
        "type": "record",
        "name": "Participant",
        "namespace": "com.satya.types",
        "fields": [
          {
            "name": "user_id",
            "type": "string",
            "satya.gdpr_subject_key": true,
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "HMAC_TOMBSTONE",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted-peer"
          },
          {
            "name": "username",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "deleted_user",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted_user"
          },
          {
            "name": "display_name",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "Deleted Participant",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "participant_kind",
            "type": {
              "type": "enum",
              "name": "ParticipantKind",
              "namespace": "com.satya.types",
              "symbols": ["HUMAN", "AI_AGENT"]
            }
          },
          {
            "name": "role",
            "type": {
              "type": "enum",
              "name": "SessionRole",
              "namespace": "com.satya.types",
              "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
            }
          },
          {
            "name": "character_id",
            "type": ["null", "string"],
            "default": null,
            "satya.pii_category": "PSEUDONYMOUS_ID",
            "satya.erasure_action": "SET_NULL",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "ai_agent_info",
            "type": [
              "null",
              {
                "type": "record",
                "name": "AiAgentInfo",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "model_id", "type": "string" },
                  { "name": "persona_id", "type": "string" },
                  { "name": "temperature", "type": "float" }
                ]
              }
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "character",
      "type": {
        "type": "record",
        "name": "CharacterSheetRecord",
        "namespace": "com.satya.types",
        "fields": [
          {
            "name": "character_id",
            "type": "string",
            "satya.pii_category": "PSEUDONYMOUS_ID",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "HMAC_TOMBSTONE"
          },
          {
            "name": "owner_user_id",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "HMAC_TOMBSTONE"
          },
          { "name": "version", "type": "int" },
          { "name": "character_name", "type": "string" },
          { "name": "callsign_or_role", "type": "string" },
          { "name": "age_years", "type": "int" },
          { "name": "origin_label", "type": "string" },
          { "name": "campaign_sqm", "type": "int" },
          { "name": "operational_heat", "type": "int" },
          { "name": "granted_access_tags", "type": { "type": "array", "items": "string" } },
          { "name": "stage_history", "type": { "type": "array", "items": "string" } },
          {
            "name": "characteristics",
            "type": {
              "type": "record",
              "name": "CharacterCharacteristicsRecord",
              "namespace": "com.satya.types",
              "fields": [
                { "name": "spd", "type": "int" },
                { "name": "for_stat", "type": "int" },
                { "name": "dex", "type": "int" },
                { "name": "kin", "type": "int" },
                { "name": "hlt", "type": "int" },
                { "name": "fit", "type": "int" },
                { "name": "hgt_m", "type": "double" },
                { "name": "mas_kg", "type": "double" },
                { "name": "mem", "type": "int" },
                { "name": "ana", "type": "int" },
                { "name": "ins", "type": "int" },
                { "name": "cre", "type": "int" },
                { "name": "dis", "type": "int" },
                { "name": "foc", "type": "int" },
                { "name": "com", "type": "int" },
                { "name": "pre", "type": "int" },
                { "name": "elo", "type": "int" },
                { "name": "sig", "type": "int" },
                { "name": "hea", "type": "int" },
                { "name": "tac", "type": "int" },
                { "name": "olf", "type": "int" },
                { "name": "tas", "type": "int" },
                { "name": "itu", "type": "int" },
                { "name": "ego", "type": "int" },
                { "name": "slf", "type": "int" },
                { "name": "opn", "type": "int" },
                { "name": "blg", "type": "int" },
                { "name": "ext", "type": "int" },
                { "name": "cnf", "type": "int" },
                { "name": "agg", "type": "int" }
              ]
            }
          },
          {
            "name": "aptitudes",
            "type": {
              "type": "record",
              "name": "CharacterAptitudesRecord",
              "namespace": "com.satya.types",
              "fields": [
                { "name": "apt_qnt", "type": "int" },
                { "name": "apt_lng", "type": "int" },
                { "name": "apt_bio", "type": "int" },
                { "name": "apt_mec", "type": "int" },
                { "name": "apt_cmp", "type": "int" },
                { "name": "apt_kin", "type": "int" },
                { "name": "apt_fin", "type": "int" },
                { "name": "apt_art", "type": "int" },
                { "name": "apt_soc", "type": "int" }
              ]
            }
          },
          { "name": "skills", "type": { "type": "map", "values": "int" } },
          { "name": "equipped_ranged_ids", "type": { "type": "array", "items": "string" } },
          { "name": "equipped_melee_codes", "type": { "type": "array", "items": "string" } },
          { "name": "equipped_armor_codes", "type": { "type": "array", "items": "string" } },
          { "name": "field_gear_ids", "type": { "type": "array", "items": "string" } },
          {
            "name": "hit_zones",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "AnatomicalZoneRecord",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "location_code", "type": "string" },
                  { "name": "wound_tier", "type": "int" },
                  { "name": "bone_status", "type": "string" },
                  { "name": "bleed_grade", "type": "int" }
                ]
              }
            }
          },
          { "name": "fatigue_level", "type": "int" },
          { "name": "exertion_marks", "type": "int" },
          { "name": "wound_shock_index", "type": "int" },
          { "name": "blood_units_lost", "type": "double" },
          { "name": "active_status_conditions", "type": { "type": "array", "items": "string" } },
          { "name": "morale_state", "type": "string" },
          { "name": "mental_trauma", "type": ["null", "string"], "default": null },
          { "name": "social_composure_lost", "type": "int" },
          { "name": "social_wound", "type": ["null", "string"], "default": null },
          { "name": "psyche_drift_marks", "type": "int" },
          {
            "name": "notes",
            "type": ["null", "string"],
            "default": null,
            "satya.pii_category": "USER_CONTENT",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "SET_NULL"
          },
          { "name": "lifepath_config_json", "type": ["null", "string"], "default": null },
          {
            "name": "assets",
            "type": {
              "type": "array",
              "items": {
                "type": "record",
                "name": "CharacterAssetRef",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "asset_id", "type": "string" },
                  {
                    "name": "asset_kind",
                    "type": {
                      "type": "enum",
                      "name": "CharacterAssetKind",
                      "namespace": "com.satya.types",
                      "symbols": ["PORTRAIT_IMAGE", "TACTICAL_TOKEN", "DOSSIER_PDF", "MODEL_3D_GLB"]
                    }
                  },
                  { "name": "filename", "type": "string" },
                  { "name": "mime_type", "type": "string" },
                  { "name": "sha256_hex", "type": "string" },
                  { "name": "size_bytes", "type": "long" },
                  { "name": "created_at_us", "type": "long" }
                ]
              }
            }
          },
          {
            "name": "verification_status",
            "type": {
              "type": "enum",
              "name": "CharacterVerificationStatus",
              "namespace": "com.satya.types",
              "symbols": ["VERIFIED_OFFICIAL", "LEGAL_CUSTOM", "TAMPERED_OR_OVER_BUDGET"]
            }
          },
          { "name": "sp_budget_valid", "type": "boolean" },
          { "name": "dag_prereqs_valid", "type": "boolean" },
          { "name": "audit_violations", "type": { "type": "array", "items": "string" } },
          { "name": "content_sha256", "type": "string" },
          { "name": "server_signature_hex", "type": ["null", "string"], "default": null },
          { "name": "updated_at_us", "type": "long" }
        ]
      }
    }
  ]
}
