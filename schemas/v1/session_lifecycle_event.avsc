{
  "type": "record",
  "name": "SessionLifecycleEvent",
  "namespace": "com.satya.events",
  "doc": "Tracks user authentication, session creation, password-protected joins, and role changes.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "timezone_offset_min", "type": "int" }
        ]
      }
    },
    {
      "name": "lifecycle_type",
      "type": {
        "type": "enum",
        "name": "LifecycleEventType",
        "symbols": [
          "USER_REGISTERED",
          "USER_AUTHENTICATED",
          "AUTH_FAILED",
          "SESSION_CREATED",
          "PARTICIPANT_JOINED",
          "PARTICIPANT_LEFT",
          "ROLE_CHANGED",
          "SESSION_ENDED"
        ]
      }
    },
    {
      "name": "actor",
      "type": {
        "type": "record",
        "name": "Participant",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "user_id", "type": "string" },
          { "name": "username", "type": "string" },
          { "name": "display_name", "type": "string" },
          {
            "name": "participant_kind",
            "type": {
              "type": "enum",
              "name": "ParticipantKind",
              "namespace": "com.satya.types",
              "symbols": ["HUMAN", "AI_AGENT"]
            }
          },
          {
            "name": "role",
            "type": {
              "type": "enum",
              "name": "SessionRole",
              "namespace": "com.satya.types",
              "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
            }
          },
          { "name": "character_id", "type": ["null", "string"], "default": null },
          {
            "name": "ai_agent_info",
            "type": [
              "null",
              {
                "type": "record",
                "name": "AiAgentInfo",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "model_id", "type": "string" },
                  { "name": "persona_id", "type": "string" },
                  { "name": "temperature", "type": "float" }
                ]
              }
            ],
            "default": null
          }
        ]
      }
    },
    { "name": "target_participant", "type": ["null", "com.satya.types.Participant"], "default": null },
    { "name": "password_protected", "type": "boolean" },
    { "name": "roster_snapshot", "type": { "type": "array", "items": "com.satya.types.Participant" } },
    { "name": "reason", "type": ["null", "string"], "default": null }
  ]
}
