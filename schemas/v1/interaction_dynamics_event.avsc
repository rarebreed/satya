{
  "type": "record",
  "name": "InteractionDynamicsEvent",
  "namespace": "com.satya.events",
  "doc": "Captures conversational turn-taking, prosody energy, pitch, and interruptions for Sleuth/Mime ML models.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "timezone_offset_min", "type": "int" }
        ]
      }
    },
    {
      "name": "speaker",
      "type": {
        "type": "record",
        "name": "Participant",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "user_id", "type": "string" },
          { "name": "username", "type": "string" },
          { "name": "display_name", "type": "string" },
          {
            "name": "participant_kind",
            "type": {
              "type": "enum",
              "name": "ParticipantKind",
              "namespace": "com.satya.types",
              "symbols": ["HUMAN", "AI_AGENT"]
            }
          },
          {
            "name": "role",
            "type": {
              "type": "enum",
              "name": "SessionRole",
              "namespace": "com.satya.types",
              "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
            }
          },
          { "name": "character_id", "type": ["null", "string"], "default": null },
          {
            "name": "ai_agent_info",
            "type": [
              "null",
              {
                "type": "record",
                "name": "AiAgentInfo",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "model_id", "type": "string" },
                  { "name": "persona_id", "type": "string" },
                  { "name": "temperature", "type": "float" }
                ]
              }
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "turn_type",
      "type": {
        "type": "enum",
        "name": "InteractionTurnType",
        "symbols": [
          "SPEECH_START",
          "SPEECH_END",
          "INTERRUPTION_OVERLAP",
          "LONG_SILENCE",
          "REACTION_GESTURE"
        ]
      }
    },
    { "name": "duration_ms", "type": "long" },
    { "name": "rms_energy_mean", "type": "float" },
    { "name": "rms_energy_peak", "type": "float" },
    { "name": "pitch_hz_estimate", "type": ["null", "float"], "default": null },
    {
      "name": "overlapped_participants",
      "type": { "type": "array", "items": "com.satya.types.Participant" },
      "doc": "Other participants who were speaking simultaneously when an overlap/interruption occurred."
    },
    { "name": "preceding_silence_ms", "type": "long" },
    { "name": "dominance_ratio", "type": "float" }
  ]
}
