{
  "type": "record",
  "name": "TtrpgMechanicsEvent",
  "namespace": "com.satya.events",
  "doc": "Captures Satya TTRPG d20 task resolution, count-up combat action economy, fatigue/wounds, and AI GM decisions.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          {
            "name": "timezone_offset_min",
            "type": "int",
            "satya.pii_category": "QUASI_IDENTIFIER",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "SET_ZERO"
          }
        ]
      }
    },
    {
      "name": "mechanic_type",
      "type": {
        "type": "enum",
        "name": "MechanicEventType",
        "symbols": ["TASK_RESOLUTION", "COMBAT_ACTION", "STATUS_CHANGE", "AI_GM_DECISION"]
      }
    },
    {
      "name": "actor",
      "satya.subject_role": "PRIMARY_ACTOR",
      "type": {
        "type": "record",
        "name": "Participant",
        "namespace": "com.satya.types",
        "fields": [
          {
            "name": "user_id",
            "type": "string",
            "satya.gdpr_subject_key": true,
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "HMAC_TOMBSTONE",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted-peer"
          },
          {
            "name": "username",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "deleted_user",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted_user"
          },
          {
            "name": "display_name",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "Deleted Participant",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "participant_kind",
            "type": {
              "type": "enum",
              "name": "ParticipantKind",
              "namespace": "com.satya.types",
              "symbols": ["HUMAN", "AI_AGENT"]
            }
          },
          {
            "name": "role",
            "type": {
              "type": "enum",
              "name": "SessionRole",
              "namespace": "com.satya.types",
              "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
            }
          },
          {
            "name": "character_id",
            "type": ["null", "string"],
            "default": null,
            "satya.pii_category": "PSEUDONYMOUS_ID",
            "satya.erasure_action": "SET_NULL",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "ai_agent_info",
            "type": [
              "null",
              {
                "type": "record",
                "name": "AiAgentInfo",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "model_id", "type": "string" },
                  { "name": "persona_id", "type": "string" },
                  { "name": "temperature", "type": "float" }
                ]
              }
            ],
            "default": null
          }
        ]
      }
    },
    {
      "name": "target_participants",
      "satya.subject_role": "SECONDARY_PARTICIPANT",
      "type": { "type": "array", "items": "com.satya.types.Participant" }
    },
    { "name": "skill_name", "type": ["null", "string"], "default": null },
    { "name": "attribute_tn", "type": ["null", "int"], "default": null, "doc": "Target Number from character attribute" },
    { "name": "difficulty_rating", "type": ["null", "int"], "default": null, "doc": "Required successes" },
    { "name": "dice_rolled_d20", "type": { "type": "array", "items": "int" } },
    { "name": "successes_counted", "type": "int" },
    {
      "name": "outcome_tier",
      "type": {
        "type": "enum",
        "name": "OutcomeTier",
        "symbols": ["CRITICAL_FAILURE", "FAILURE", "PARTIAL_SUCCESS", "SUCCESS", "EXTRAORDINARY_SUCCESS"]
      }
    },
    { "name": "action_time_factor", "type": ["null", "float"], "default": null },
    { "name": "action_time_cost", "type": ["null", "int"], "default": null },
    { "name": "action_count_cost", "type": ["null", "int"], "default": null },
    {
      "name": "combat_stance",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "CombatStance",
          "symbols": ["POWER", "MANEUVER", "STABILITY", "RANGED_AIMED", "RANGED_SNAP"]
        }
      ],
      "default": null
    },
    { "name": "fatigue_level", "type": "int" },
    { "name": "wound_shock_index", "type": "float" },
    {
      "name": "notes",
      "type": ["null", "string"],
      "default": null,
      "satya.pii_category": "USER_CONTENT",
      "satya.pii_owner": "PRIMARY_ACTOR",
      "satya.erasure_action": "SET_NULL"
    }
  ]
}
