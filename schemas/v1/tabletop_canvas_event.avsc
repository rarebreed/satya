{
  "type": "record",
  "name": "TabletopCanvasEvent",
  "namespace": "com.satya.events",
  "doc": "Captures tactical map generation, token coordinate updates, fog-of-war mutations, and deterministic 3D wgpu dice physics rolls.",
  "fields": [
    {
      "name": "metadata",
      "type": {
        "type": "record",
        "name": "EventMetadata",
        "namespace": "com.satya.types",
        "fields": [
          { "name": "event_id", "type": "string" },
          { "name": "sequence_num", "type": "long" },
          { "name": "schema_subject", "type": "string" },
          { "name": "schema_version", "type": "int" },
          { "name": "schema_fingerprint_crc64", "type": "bytes" },
          { "name": "session_id", "type": "string" },
          {
            "name": "session_mode",
            "type": {
              "type": "enum",
              "name": "SessionMode",
              "namespace": "com.satya.types",
              "symbols": ["TTRPG", "MEETING"]
            }
          },
          { "name": "client_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          { "name": "ingest_timestamp_us", "type": { "type": "long", "logicalType": "timestamp-micros" } },
          {
            "name": "timezone_offset_min",
            "type": "int",
            "satya.pii_category": "QUASI_IDENTIFIER",
            "satya.pii_owner": "PRIMARY_ACTOR",
            "satya.erasure_action": "SET_ZERO"
          }
        ]
      }
    },
    {
      "name": "canvas_event_type",
      "type": {
        "type": "enum",
        "name": "CanvasEventType",
        "symbols": [
          "MAP_GENERATED",
          "MAP_UPDATED",
          "TOKEN_MOVED",
          "TOKEN_ADDED",
          "TOKEN_REMOVED",
          "FOG_OF_WAR_UPDATED",
          "WGPU_DICE_SPAWNED"
        ]
      }
    },
    {
      "name": "actor",
      "satya.subject_role": "PRIMARY_ACTOR",
      "type": {
        "type": "record",
        "name": "Participant",
        "namespace": "com.satya.types",
        "fields": [
          {
            "name": "user_id",
            "type": "string",
            "satya.gdpr_subject_key": true,
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "HMAC_TOMBSTONE",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted-peer"
          },
          {
            "name": "username",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "deleted_user",
            "satya.dsar_third_party_mask": true,
            "satya.dsar_mask_value": "redacted_user"
          },
          {
            "name": "display_name",
            "type": "string",
            "satya.pii_category": "DIRECT_IDENTIFIER",
            "satya.erasure_action": "REPLACE_STATIC",
            "satya.erasure_replacement": "Deleted Participant",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "participant_kind",
            "type": {
              "type": "enum",
              "name": "ParticipantKind",
              "namespace": "com.satya.types",
              "symbols": ["HUMAN", "AI_AGENT"]
            }
          },
          {
            "name": "role",
            "type": {
              "type": "enum",
              "name": "SessionRole",
              "namespace": "com.satya.types",
              "symbols": ["GM", "AI_GM", "PLAYER", "HOST", "PARTICIPANT", "OBSERVER"]
            }
          },
          {
            "name": "character_id",
            "type": ["null", "string"],
            "default": null,
            "satya.pii_category": "PSEUDONYMOUS_ID",
            "satya.erasure_action": "SET_NULL",
            "satya.dsar_third_party_mask": false
          },
          {
            "name": "ai_agent_info",
            "type": [
              "null",
              {
                "type": "record",
                "name": "AiAgentInfo",
                "namespace": "com.satya.types",
                "fields": [
                  { "name": "model_id", "type": "string" },
                  { "name": "persona_id", "type": "string" },
                  { "name": "temperature", "type": "float" }
                ]
              }
            ],
            "default": null
          }
        ]
      }
    },
    { "name": "map_id", "type": ["null", "string"], "default": null },
    { "name": "map_title", "type": ["null", "string"], "default": null },
    { "name": "image_url", "type": ["null", "string"], "default": null },
    { "name": "grid_width", "type": ["null", "int"], "default": null },
    { "name": "grid_height", "type": ["null", "int"], "default": null },
    {
      "name": "token_placements",
      "type": {
        "type": "array",
        "items": {
          "type": "record",
          "name": "TokenPlacement",
          "namespace": "com.satya.types",
          "fields": [
            { "name": "entity_id", "type": "string" },
            { "name": "label", "type": "string" },
            { "name": "x", "type": "int" },
            { "name": "y", "type": "int" },
            {
              "name": "visibility",
              "type": {
                "type": "enum",
                "name": "MessageVisibility",
                "namespace": "com.satya.types",
                "symbols": ["PUBLIC", "PRIVATE", "GM_ONLY", "HOST_ONLY"]
              }
            }
          ]
        }
      },
      "default": []
    },
    {
      "name": "wgpu_dice_roll",
      "type": [
        "null",
        {
          "type": "record",
          "name": "WgpuDiceSpec",
          "namespace": "com.satya.types",
          "fields": [
            { "name": "dice_notation", "type": "string" },
            { "name": "physics_seed", "type": "long" },
            { "name": "outcomes", "type": { "type": "array", "items": "int" } },
            { "name": "visibility", "type": "com.satya.types.MessageVisibility" }
          ]
        }
      ],
      "default": null
    },
    {
      "name": "terrain_notes",
      "type": ["null", "string"],
      "default": null,
      "satya.pii_category": "USER_CONTENT",
      "satya.pii_owner": "PRIMARY_ACTOR",
      "satya.erasure_action": "SET_NULL"
    }
  ]
}
